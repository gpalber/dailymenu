# ── Copy to .env (gitignored). This is the complete credential list for ALL v0 slices. ──

# 1) SUPABASE — production Postgres (free tier)
#    Dashboard → Connect → "Session pooler" connection string.
#    Leave unset for local dev (embedded PGlite in .data/).
DATABASE_URL=

# 2) CLOUDFLARE — Workers deploy (public URL) + R2 snapshot bucket (free tier)
#    Dash → My Profile → API Tokens → "Edit Cloudflare Workers" template + add R2:Edit.
#    Account ID: dashboard right sidebar on the account home.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# 3) ANTHROPIC — pipeline extraction (Batch API; ~€14 backfill, ~€2-5/mo after)
ANTHROPIC_API_KEY=

# 4) GITHUB — repo hosting + Actions cron for the weekly crawl (free on public repos)
#    Create an empty PUBLIC repo, then a fine-grained PAT scoped to it:
#    Contents R/W + Secrets R/W + Workflows R/W. I push code and set Actions secrets with it.
GITHUB_REPO=            # e.g. youruser/daily-menu
GITHUB_TOKEN=

# 5) TRIPADVISOR CONTENT API — live review quotes + name/website enrichment (Slice 4)
#    developer-tripadvisor.com/content-api → sign up (card required) → SET DAILY BUDGET ~€1
#    so the free 5,000 calls/month can never be exceeded by much.
TRIPADVISOR_API_KEY=

# 6) BRAVE SEARCH API — OPTIONAL website discovery fallback ($5 one-off prepaid)
#    api-dashboard.search.brave.com. Skip it and discovery slow-rolls via TripAdvisor instead.
BRAVE_API_KEY=

# R2 snapshot bucket S3 credentials (created WITH the Cloudflare token above — I generate
# these myself via wrangler once CLOUDFLARE_API_TOKEN exists; you don't need to fill them)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=dailymenu-snapshots
