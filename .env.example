# Production database (Supabase session pooler connection string).
# Leave unset for local dev — the API and pipeline fall back to an embedded PGlite DB in .data/
DATABASE_URL=

# Anthropic — pipeline extraction (Slice 1+)
ANTHROPIC_API_KEY=

# TripAdvisor Content API (Slice 4)
TRIPADVISOR_API_KEY=

# Cloudflare R2 snapshot storage, S3-compatible creds (Slice 1)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=dailymenu-snapshots
